<section
  class="tab scrollable {{tabs.dynamicWebs.cssClass}}"
  data-group="sheet"
  data-tab="dynamicWebs"
  data-application-part="dynamicWebs"
  data-dynamic-webs-scene-config
>
  <fieldset>
    <legend>Web density by category</legend>

    {{#each webCategoryDensityControls}}
      <div
        class="form-group"
        data-dynamic-webs-density-slider
        data-web-category="{{categoryId}}"
        data-density-id="{{densityId}}"
      >
        <label
          for="{{domId}}"
          title="{{description}}"
        >
          {{label}}
          {{#if future}}
            <span class="units">(future)</span>
          {{/if}}
        </label>

        <div class="form-fields">
          <input
            id="{{domId}}"
            type="range"
            value="{{sliderValue}}"
            min="{{minimum}}"
            max="{{maximum}}"
            step="{{step}}"
            aria-describedby="{{outputId}}"
            title="{{description}}"
            data-dynamic-webs-density-range
            {{#unless ../editable}}disabled{{/unless}}
          >

          <input
            type="hidden"
            name="{{fieldName}}"
            value="{{densityId}}"
            data-dynamic-webs-density-value
            {{#unless ../editable}}disabled{{/unless}}
          >

          <output
            id="{{outputId}}"
            for="{{domId}}"
            data-density-id="{{densityId}}"
            data-dynamic-webs-density-output
          >
            {{densityLabel}}
          </output>
        </div>

        <p class="hint">
          {{description}}
          <br>
          <small>{{sourceLabel}}</small>
        </p>
      </div>
    {{/each}}
  </fieldset>

  <fieldset>
    <legend>Web appearance</legend>

    <div class="form-group">
      <label
        for="dynamic-webs-web-colour"
        title="{{webColourControl.description}}"
      >
        {{webColourControl.label}}
      </label>

      <div class="form-fields">
        <select
          id="dynamic-webs-web-colour"
          name="{{fieldNames.webColour}}"
          title="{{webColourControl.description}}"
          {{#unless editable}}disabled{{/unless}}
        >
          {{#each webColourControl.options}}
            <option
              value="{{value}}"
              {{#if selected}}selected{{/if}}
            >
              {{label}}
            </option>
          {{/each}}
        </select>
      </div>

      <p class="hint">
        {{webColourControl.description}}
      </p>
    </div>

    <div class="form-group">
      <label
        for="dynamic-webs-web-thickness"
        title="{{webThicknessControl.description}}"
      >
        {{webThicknessControl.label}}
      </label>

      <div class="form-fields">
        <input
          id="dynamic-webs-web-thickness"
          type="number"
          name="{{fieldNames.webThickness}}"
          value="{{webThicknessControl.value}}"
          min="{{webThicknessControl.minimum}}"
          max="{{webThicknessControl.maximum}}"
          step="{{webThicknessControl.step}}"
          title="{{webThicknessControl.description}}"
          {{#unless editable}}disabled{{/unless}}
        >
        <span class="units">×</span>
      </div>

      <p class="hint">
        {{webThicknessControl.description}}
      </p>
    </div>
  </fieldset>
</section>
