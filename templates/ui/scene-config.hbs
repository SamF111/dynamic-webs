<section
  class="tab scrollable {{tabs.dynamicWebs.cssClass}}"
  data-group="sheet"
  data-tab="dynamicWebs"
  data-application-part="dynamicWebs"
  data-dynamic-webs-scene-config
>
  <input
    type="hidden"
    name="{{fieldNames.webPopulations}}"
    value="{{populationValue}}"
    data-dynamic-webs-populations-value
    {{#unless editable}}disabled{{/unless}}
  >

  <p class="hint">{{levelProviderHint}}</p>

  <div data-dynamic-webs-population-list>
    {{#each populationCards}}
      {{> "modules/dynamic-webs/templates/ui/web-population-card.hbs"}}
    {{/each}}
  </div>

  <p class="hint" data-dynamic-webs-population-empty {{#if hasPopulations}}hidden{{/if}}>
    No web populations are configured. Add a population to generate webs on a selected level.
  </p>

  <div class="form-group">
    <div class="form-fields">
      <button type="button" data-dynamic-webs-add-population {{#unless editable}}disabled{{/unless}}>
        <i class="fas fa-plus"></i> Add Web Population
      </button>
    </div>
  </div>

  <template data-dynamic-webs-population-template>
    {{#with newPopulationCard}}
      {{> "modules/dynamic-webs/templates/ui/web-population-card.hbs"}}
    {{/with}}
  </template>
</section>
