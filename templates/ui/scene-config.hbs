<section
  class="tab scrollable {{tabs.dynamicWebs.cssClass}}"
  data-group="sheet"
  data-tab="dynamicWebs"
  data-application-part="dynamicWebs"
  data-dynamic-webs-scene-config
>
  <input
    type="hidden"
    name="{{fieldNames.webPopulations}}"
    value="{{populationValue}}"
    data-dynamic-webs-populations-value
    {{#unless editable}}disabled{{/unless}}
  >

  <input
    type="hidden"
    name="{{fieldNames.spanWebBehaviour}}"
    value="{{spanWebBehaviourValue}}"
    data-dynamic-webs-span-behaviour-value
    {{#unless editable}}disabled{{/unless}}
  >

  <p class="hint">{{levelProviderHint}}</p>

  {{#if populationDefaultsHint}}
    <p class="hint">{{populationDefaultsHint}}</p>
  {{/if}}

  <div data-dynamic-webs-population-list>
    {{#each populationCards}}
      {{> "modules/dynamic-webs/templates/ui/web-population-card.hbs"}}
    {{/each}}
  </div>

  <p class="hint" data-dynamic-webs-population-empty {{#if hasPopulations}}hidden{{/if}}>
    No web populations are configured. Add a population to generate webs on a selected level.
  </p>

  <div class="form-group">
    <div class="form-fields">
      <button type="button" data-dynamic-webs-add-population {{#unless editable}}disabled{{/unless}}>
        <i class="fas fa-plus"></i> Add Web Population
      </button>
    </div>
  </div>

  <details
    class="dynamic-webs-population-section"
    data-dynamic-webs-span-behaviour-section
  >
    <summary>
      <strong>Span behaviour</strong>
      <span class="hint">{{spanWebBehaviour.summary}}</span>
    </summary>

    <div class="dynamic-webs-population-section-body">
      <div class="form-group">
        <label>Use world maximum span width</label>
        <div class="form-fields">
          <input
            type="checkbox"
            {{#if spanWebBehaviour.useWorldMaximumSpanWidth}}checked{{/if}}
            data-dynamic-webs-use-world-span-width
            data-dynamic-webs-span-behaviour-control
          >
          <span class="units">{{spanWebBehaviour.worldMaximumSpanGridUnits}} grid units</span>
        </div>
      </div>

      <div class="form-group">
        <label>Maximum span width</label>
        <div class="form-fields">
          <input
            type="number"
            value="{{spanWebBehaviour.maximumSpanGridUnits}}"
            min="{{spanWebBehaviour.maximumMinimum}}"
            max="{{spanWebBehaviour.maximumMaximum}}"
            step="{{spanWebBehaviour.maximumStep}}"
            data-dynamic-webs-span-maximum-width
            data-dynamic-webs-span-behaviour-control
          >
          <span class="units">grid units</span>
        </div>
        <p class="hint">Applies to every wall-span population in this Scene. Clear the world-default checkbox to store a Scene override.</p>
      </div>

      <div class="form-group">
        <label>Span vision</label>
        <div class="form-fields">
          <select
            data-dynamic-webs-span-vision-mode
            data-dynamic-webs-span-behaviour-control
          >
            {{#each spanWebBehaviour.visionOptions}}
              <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </div>
        <p class="hint">None creates no vision wall. Limited permits vision through one limited wall. Blocked uses normal sight blocking.</p>
      </div>

      <div class="form-group">
        <label>Block movement</label>
        <div class="form-fields">
          <input
            type="checkbox"
            {{#if spanWebBehaviour.secretDoor}}checked{{/if}}
            data-dynamic-webs-span-secret-door
            data-dynamic-webs-span-behaviour-control
          >
        </div>
        <p class="hint">Uses a module-owned closed secret-door wall for each intact span. This is the only movement-blocking mode.</p>
      </div>

      <div class="form-group">
        <label>On attempted crossing</label>
        <div class="form-fields">
          <select
            data-dynamic-webs-span-crossing-action
            data-dynamic-webs-span-behaviour-control
          >
            {{#each spanWebBehaviour.crossingActionOptions}}
              <option
                value="{{value}}"
                {{#if selected}}selected{{/if}}
                {{#if disabled}}disabled{{/if}}
              >{{label}}</option>
            {{/each}}
          </select>
        </div>
        <p class="hint">Open Secret Door changes the generated door state and keeps the web intact. Destroy Web removes the web asset/state; when movement blocking is enabled, its secret door opens and remains for later clean-up instead of being deleted during the crossing. No Action leaves the web unchanged.</p>
      </div>

      <hr>

      <div class="form-group">
        <label>Web state and wall maintenance</label>
        <div class="form-fields">
          <button
            type="button"
            data-dynamic-webs-restore-destroyed-spans
            data-destroyed-count="{{spanWebBehaviour.destroyedWebCount}}"
            {{#unless spanWebBehaviour.hasDestroyedWebs}}disabled{{/unless}}
            {{#unless editable}}disabled{{/unless}}
          >
            <i class="fas fa-undo"></i> Restore Destroyed Span Webs
            (<span data-dynamic-webs-restore-span-count>{{spanWebBehaviour.destroyedWebCount}}</span>)
          </button>

          <button
            type="button"
            data-dynamic-webs-update-span-walls
            data-active-scene="{{#if spanWebBehaviour.isActiveScene}}true{{else}}false{{/if}}"
            {{#unless editable}}disabled{{/unless}}
          >
            <i class="fas fa-sync-alt"></i> Update Web Walls
          </button>

          <button
            type="button"
            data-dynamic-webs-delete-span-walls
            {{#unless editable}}disabled{{/unless}}
          >
            <i class="fas fa-trash"></i> Delete Web Walls
          </button>
        </div>
        <p class="hint">Restore Destroyed Span Webs clears this Scene's persistent destroyed-span state immediately. The active Scene restores incrementally; an inactive Scene restores its saved state without generating geometry and completes derived-wall creation when next opened. Save configuration changes before using Update Web Walls, which fully reconciles the active Scene. Delete Web Walls removes every generated web WallDocument without changing populations or destroyed-span state.</p>
        {{#unless spanWebBehaviour.isActiveScene}}
          <p class="hint warning">Open this Scene on the canvas before using Update Web Walls. Delete Web Walls remains available for inactive Scenes.</p>
        {{/unless}}
      </div>
    </div>
  </details>

  <template data-dynamic-webs-population-template>
    {{#with newPopulationCard}}
      {{> "modules/dynamic-webs/templates/ui/web-population-card.hbs"}}
    {{/with}}
  </template>
</section>


